<?xml version="1.0" encoding="UTF-8"?>
<!--
  The credentials publish-snapshots.yaml and release.yaml deploy with, and nothing else.

  The server 'github' is the one 'distributionManagement' of the root POM names:
  publish-snapshots.yaml uploads this repository's own snapshots, and the job 'publish' of
  release.yaml a release, to pbinitiative's GitHub Packages with the workflow's GITHUB_TOKEN,
  which needs no secret of ours.

  Reading needs no settings. The VanillaBP snapshots this repository builds against come from
  the snapshot repository of Maven Central, which the root POM names and which asks for no
  login.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
    <servers>
        <!-- used for 'mvn deploy' by the root POM's distributionManagement -->
        <server>
            <id>github</id>
            <username>${env.GITHUB_ACTOR}</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>
    </servers>

</settings>
