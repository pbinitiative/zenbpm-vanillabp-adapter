<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.pbinitiative.zenbpm</groupId>
    <artifactId>zenbpm-vanillabp-adapter-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>zenbpm-vanillabp-adapter-election-integration-test</artifactId>
  <name>VanillaBP adapter for ZenBPM - Election integration test</name>
  <description>The BPMS election of a Spring Boot application against the pinned engine: two adapter ids on one engine, and the adapter next to the platform's BPMS double.</description>

  <properties>
    <!-- nothing to publish - this module only tests -->
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.pbinitiative.zenbpm</groupId>
      <artifactId>zenbpm-vanillabp-adapter-spring-boot</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- the platform's JDBC outbox and delivery log on an in-memory database, which the two
         applications of a migration share -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- the second BPMS of an application, which holds the workflows the tests say it holds -->
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>bpms-double-spring-boot</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>test-utils</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.pbinitiative.zenbpm</groupId>
      <artifactId>zenbpm-vanillabp-adapter-engine-test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
