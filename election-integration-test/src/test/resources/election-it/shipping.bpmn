<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="election-it-shipping"
    xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" targetNamespace="http://bpmn.io/schema/bpmn"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="Shipping" isExecutable="true">
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_ToConfirm</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Confirm" name="Confirm the shipment">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="confirm" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToConfirm</bpmn:incoming>
      <bpmn:outgoing>Flow_ToShip</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Ship" name="Ship the shipment">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="ship" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToShip</bpmn:incoming>
      <bpmn:outgoing>Flow_ToShipped</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Shipped">
      <bpmn:incoming>Flow_ToShipped</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToConfirm" sourceRef="Start" targetRef="Confirm" />
    <bpmn:sequenceFlow id="Flow_ToShip" sourceRef="Confirm" targetRef="Ship" />
    <bpmn:sequenceFlow id="Flow_ToShipped" sourceRef="Ship" targetRef="Shipped" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Shipping">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="160" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Confirm_di" bpmnElement="Confirm">
        <dc:Bounds x="256" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ship_di" bpmnElement="Ship">
        <dc:Bounds x="416" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shipped_di" bpmnElement="Shipped">
        <dc:Bounds x="576" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToConfirm_di" bpmnElement="Flow_ToConfirm">
        <di:waypoint x="196" y="98" />
        <di:waypoint x="226" y="98" />
        <di:waypoint x="226" y="120" />
        <di:waypoint x="256" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToShip_di" bpmnElement="Flow_ToShip">
        <di:waypoint x="356" y="120" />
        <di:waypoint x="416" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToShipped_di" bpmnElement="Flow_ToShipped">
        <di:waypoint x="516" y="120" />
        <di:waypoint x="546" y="120" />
        <di:waypoint x="546" y="98" />
        <di:waypoint x="576" y="98" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
