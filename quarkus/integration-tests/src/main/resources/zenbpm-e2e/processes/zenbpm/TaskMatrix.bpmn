<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="zenbpm-e2e-task-matrix"
    xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" targetNamespace="http://bpmn.io/schema/bpmn"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="TaskMatrix" isExecutable="true">
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_ToWeigh</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Weigh" name="Weigh the parcel">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="weigh" />
        <zenbpm:ioMapping>
          <zenbpm:input source="=&quot;standard&quot;" target="tariff" />
        </zenbpm:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToWeigh</bpmn:incoming>
      <bpmn:outgoing>Flow_ToExpress</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Express" name="Express?" default="Flow_NotExpress">
      <bpmn:incoming>Flow_ToExpress</bpmn:incoming>
      <bpmn:outgoing>Flow_IsExpress</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotExpress</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="NotifyCourier" name="Notify the courier">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="notify-courier" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_IsExpress</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifiedToRate</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:businessRuleTask id="Rate" name="Rate the parcel">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="rate" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NotifiedToRate</bpmn:incoming>
      <bpmn:incoming>Flow_NotExpress</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPacking</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:subProcess id="Packing" name="Packing">
      <bpmn:incoming>Flow_ToPacking</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPacked</bpmn:outgoing>
      <bpmn:startEvent id="PackingStart">
        <bpmn:outgoing>Flow_ToPack</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Pack" name="Pack the parcel">
        <bpmn:extensionElements>
          <zenbpm:taskDefinition type="pack" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ToPack</bpmn:incoming>
        <bpmn:outgoing>Flow_ToPackingEnd</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="PackingEnd">
        <bpmn:incoming>Flow_ToPackingEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ToPack" sourceRef="PackingStart" targetRef="Pack" />
      <bpmn:sequenceFlow id="Flow_ToPackingEnd" sourceRef="Pack" targetRef="PackingEnd" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="PackedGateway" name="Packed?" default="Flow_NotPacked">
      <bpmn:incoming>Flow_ToPacked</bpmn:incoming>
      <bpmn:outgoing>Flow_IsPacked</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotPacked</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Packed">
      <bpmn:incoming>Flow_IsPacked</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="NotPacked">
      <bpmn:incoming>Flow_NotPacked</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToWeigh" sourceRef="Start" targetRef="Weigh" />
    <bpmn:sequenceFlow id="Flow_ToExpress" sourceRef="Weigh" targetRef="Express" />
    <bpmn:sequenceFlow id="Flow_IsExpress" sourceRef="Express" targetRef="NotifyCourier">
      <bpmn:conditionExpression>=express</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotExpress" sourceRef="Express" targetRef="Rate" />
    <bpmn:sequenceFlow id="Flow_NotifiedToRate" sourceRef="NotifyCourier" targetRef="Rate" />
    <bpmn:sequenceFlow id="Flow_ToPacking" sourceRef="Rate" targetRef="Packing" />
    <bpmn:sequenceFlow id="Flow_ToPacked" sourceRef="Packing" targetRef="PackedGateway" />
    <bpmn:sequenceFlow id="Flow_IsPacked" sourceRef="PackedGateway" targetRef="Packed">
      <bpmn:conditionExpression>=packed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotPacked" sourceRef="PackedGateway" targetRef="NotPacked" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="TaskMatrix">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="160" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Weigh_di" bpmnElement="Weigh">
        <dc:Bounds x="256" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Express_di" bpmnElement="Express">
        <dc:Bounds x="416" y="80" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotifyCourier_di" bpmnElement="NotifyCourier">
        <dc:Bounds x="526" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Rate_di" bpmnElement="Rate">
        <dc:Bounds x="686" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Packing_di" bpmnElement="Packing" isExpanded="true">
        <dc:Bounds x="846" y="80" width="352" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PackingStart_di" bpmnElement="PackingStart">
        <dc:Bounds x="876" y="110" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pack_di" bpmnElement="Pack">
        <dc:Bounds x="972" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PackingEnd_di" bpmnElement="PackingEnd">
        <dc:Bounds x="1132" y="110" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PackedGateway_di" bpmnElement="PackedGateway">
        <dc:Bounds x="1258" y="80" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Packed_di" bpmnElement="Packed">
        <dc:Bounds x="1368" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotPacked_di" bpmnElement="NotPacked">
        <dc:Bounds x="1368" y="166" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToPack_di" bpmnElement="Flow_ToPack">
        <di:waypoint x="912" y="128" />
        <di:waypoint x="942" y="128" />
        <di:waypoint x="942" y="150" />
        <di:waypoint x="972" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToPackingEnd_di" bpmnElement="Flow_ToPackingEnd">
        <di:waypoint x="1072" y="150" />
        <di:waypoint x="1102" y="150" />
        <di:waypoint x="1102" y="128" />
        <di:waypoint x="1132" y="128" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToWeigh_di" bpmnElement="Flow_ToWeigh">
        <di:waypoint x="196" y="98" />
        <di:waypoint x="226" y="98" />
        <di:waypoint x="226" y="120" />
        <di:waypoint x="256" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToExpress_di" bpmnElement="Flow_ToExpress">
        <di:waypoint x="356" y="120" />
        <di:waypoint x="386" y="120" />
        <di:waypoint x="386" y="105" />
        <di:waypoint x="416" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_IsExpress_di" bpmnElement="Flow_IsExpress">
        <di:waypoint x="466" y="105" />
        <di:waypoint x="496" y="105" />
        <di:waypoint x="496" y="120" />
        <di:waypoint x="526" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NotExpress_di" bpmnElement="Flow_NotExpress">
        <di:waypoint x="466" y="105" />
        <di:waypoint x="576" y="105" />
        <di:waypoint x="576" y="120" />
        <di:waypoint x="686" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NotifiedToRate_di" bpmnElement="Flow_NotifiedToRate">
        <di:waypoint x="626" y="120" />
        <di:waypoint x="686" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToPacking_di" bpmnElement="Flow_ToPacking">
        <di:waypoint x="786" y="120" />
        <di:waypoint x="816" y="120" />
        <di:waypoint x="816" y="150" />
        <di:waypoint x="846" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToPacked_di" bpmnElement="Flow_ToPacked">
        <di:waypoint x="1198" y="150" />
        <di:waypoint x="1228" y="150" />
        <di:waypoint x="1228" y="105" />
        <di:waypoint x="1258" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_IsPacked_di" bpmnElement="Flow_IsPacked">
        <di:waypoint x="1308" y="105" />
        <di:waypoint x="1338" y="105" />
        <di:waypoint x="1338" y="98" />
        <di:waypoint x="1368" y="98" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NotPacked_di" bpmnElement="Flow_NotPacked">
        <di:waypoint x="1308" y="105" />
        <di:waypoint x="1338" y="105" />
        <di:waypoint x="1338" y="184" />
        <di:waypoint x="1368" y="184" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
