<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="zenbpm-e2e-task-taken-away"
    xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" targetNamespace="http://bpmn.io/schema/bpmn"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="TaskTakenAway" isExecutable="true">
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_ToSplit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Split">
      <bpmn:incoming>Flow_ToSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToHold</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToCheck</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Hold" name="Hold the room">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="hold" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToHold</bpmn:incoming>
      <bpmn:outgoing>Flow_ToHeld</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="HoldExpired" name="Hold expired" attachedToRef="Hold" cancelActivity="true">
      <bpmn:outgoing>Flow_ToReleased</bpmn:outgoing>
      <bpmn:timerEventDefinition id="HoldExpired_Definition">
        <bpmn:timeDuration>PT2S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Held">
      <bpmn:incoming>Flow_ToHeld</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Released">
      <bpmn:incoming>Flow_ToReleased</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Check" name="Check the payment">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="check" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ToChecked</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Checked">
      <bpmn:incoming>Flow_ToChecked</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToSplit" sourceRef="Start" targetRef="Split" />
    <bpmn:sequenceFlow id="Flow_ToHold" sourceRef="Split" targetRef="Hold" />
    <bpmn:sequenceFlow id="Flow_ToCheck" sourceRef="Split" targetRef="Check" />
    <bpmn:sequenceFlow id="Flow_ToHeld" sourceRef="Hold" targetRef="Held" />
    <bpmn:sequenceFlow id="Flow_ToReleased" sourceRef="HoldExpired" targetRef="Released" />
    <bpmn:sequenceFlow id="Flow_ToChecked" sourceRef="Check" targetRef="Checked" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="TaskTakenAway">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="160" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Split_di" bpmnElement="Split">
        <dc:Bounds x="256" y="80" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Hold_di" bpmnElement="Hold">
        <dc:Bounds x="366" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Check_di" bpmnElement="Check">
        <dc:Bounds x="366" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Held_di" bpmnElement="Held">
        <dc:Bounds x="526" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Checked_di" bpmnElement="Checked">
        <dc:Bounds x="526" y="166" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Released_di" bpmnElement="Released">
        <dc:Bounds x="160" y="340" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HoldExpired_di" bpmnElement="HoldExpired">
        <dc:Bounds x="440" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToSplit_di" bpmnElement="Flow_ToSplit">
        <di:waypoint x="196" y="98" />
        <di:waypoint x="226" y="98" />
        <di:waypoint x="226" y="105" />
        <di:waypoint x="256" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToHold_di" bpmnElement="Flow_ToHold">
        <di:waypoint x="306" y="105" />
        <di:waypoint x="336" y="105" />
        <di:waypoint x="336" y="120" />
        <di:waypoint x="366" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToCheck_di" bpmnElement="Flow_ToCheck">
        <di:waypoint x="306" y="105" />
        <di:waypoint x="336" y="105" />
        <di:waypoint x="336" y="250" />
        <di:waypoint x="366" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToHeld_di" bpmnElement="Flow_ToHeld">
        <di:waypoint x="466" y="120" />
        <di:waypoint x="496" y="120" />
        <di:waypoint x="496" y="98" />
        <di:waypoint x="526" y="98" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToReleased_di" bpmnElement="Flow_ToReleased">
        <di:waypoint x="458" y="178" />
        <di:waypoint x="458" y="396" />
        <di:waypoint x="178" y="396" />
        <di:waypoint x="178" y="376" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToChecked_di" bpmnElement="Flow_ToChecked">
        <di:waypoint x="466" y="250" />
        <di:waypoint x="496" y="250" />
        <di:waypoint x="496" y="184" />
        <di:waypoint x="526" y="184" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
