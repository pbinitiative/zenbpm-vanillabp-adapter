<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="zenbpm-e2e-shipments"
    xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" targetNamespace="http://bpmn.io/schema/bpmn"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="Shipments" isExecutable="true">
    <bpmn:startEvent id="Ordered">
      <bpmn:outgoing>Flow_ToScenario</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Scenario">
      <bpmn:incoming>Flow_ToScenario</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWaitToShip</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToPacking</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToBoxing</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToInspection</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="WaitToShip" name="Five seconds">
      <bpmn:incoming>Flow_ToWaitToShip</bpmn:incoming>
      <bpmn:outgoing>Flow_ToShipApproved</bpmn:outgoing>
      <bpmn:timerEventDefinition id="WaitToShip_Definition">
        <bpmn:timeDuration>PT5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="ShipApproved" name="Approved?" default="Flow_ToHeld">
      <bpmn:incoming>Flow_ToShipApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToShipped</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToHeld</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Shipped">
      <bpmn:incoming>Flow_ToShipped</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Held">
      <bpmn:incoming>Flow_ToHeld</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Packing" name="Packing">
      <bpmn:incoming>Flow_ToPacking</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPacked</bpmn:outgoing>
      <bpmn:startEvent id="PackingStarted">
        <bpmn:outgoing>Flow_ToWaitToPack</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:intermediateCatchEvent id="WaitToPack" name="Five seconds">
        <bpmn:incoming>Flow_ToWaitToPack</bpmn:incoming>
        <bpmn:outgoing>Flow_ToPackApproved</bpmn:outgoing>
        <bpmn:timerEventDefinition id="WaitToPack_Definition">
          <bpmn:timeDuration>PT5S</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="PackApproved" name="Approved?" default="Flow_ToPackHeld">
        <bpmn:incoming>Flow_ToPackApproved</bpmn:incoming>
        <bpmn:outgoing>Flow_ToPackShipped</bpmn:outgoing>
        <bpmn:outgoing>Flow_ToPackHeld</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="PackedForShipping">
        <bpmn:incoming>Flow_ToPackShipped</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="PackedAndHeld">
        <bpmn:incoming>Flow_ToPackHeld</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ToWaitToPack" sourceRef="PackingStarted" targetRef="WaitToPack" />
      <bpmn:sequenceFlow id="Flow_ToPackApproved" sourceRef="WaitToPack" targetRef="PackApproved" />
      <bpmn:sequenceFlow id="Flow_ToPackShipped" sourceRef="PackApproved" targetRef="PackedForShipping">
        <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_ToPackHeld" sourceRef="PackApproved" targetRef="PackedAndHeld" />
    </bpmn:subProcess>
    <bpmn:endEvent id="Packed">
      <bpmn:incoming>Flow_ToPacked</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Boxing" name="Boxing">
      <bpmn:incoming>Flow_ToBoxing</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBoxed</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zenbpm:loopCharacteristics inputCollection="=[&quot;first&quot;, &quot;second&quot;, &quot;third&quot;]" inputElement="box" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="BoxingStarted">
        <bpmn:outgoing>Flow_ToWaitToBox</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:intermediateCatchEvent id="WaitToBox" name="Five seconds">
        <bpmn:incoming>Flow_ToWaitToBox</bpmn:incoming>
        <bpmn:outgoing>Flow_ToBoxApproved</bpmn:outgoing>
        <bpmn:timerEventDefinition id="WaitToBox_Definition">
          <bpmn:timeDuration>PT5S</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="BoxApproved" name="Approved?" default="Flow_ToBoxHeld">
        <bpmn:incoming>Flow_ToBoxApproved</bpmn:incoming>
        <bpmn:outgoing>Flow_ToBoxShipped</bpmn:outgoing>
        <bpmn:outgoing>Flow_ToBoxHeld</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="BoxedForShipping">
        <bpmn:incoming>Flow_ToBoxShipped</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="BoxedAndHeld">
        <bpmn:incoming>Flow_ToBoxHeld</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ToWaitToBox" sourceRef="BoxingStarted" targetRef="WaitToBox" />
      <bpmn:sequenceFlow id="Flow_ToBoxApproved" sourceRef="WaitToBox" targetRef="BoxApproved" />
      <bpmn:sequenceFlow id="Flow_ToBoxShipped" sourceRef="BoxApproved" targetRef="BoxedForShipping">
        <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_ToBoxHeld" sourceRef="BoxApproved" targetRef="BoxedAndHeld" />
    </bpmn:subProcess>
    <bpmn:endEvent id="Boxed">
      <bpmn:incoming>Flow_ToBoxed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Inspection" name="Inspection">
      <bpmn:incoming>Flow_ToInspection</bpmn:incoming>
      <bpmn:outgoing>Flow_ToInspected</bpmn:outgoing>
      <bpmn:startEvent id="InspectionStarted">
        <bpmn:outgoing>Flow_ToInspect</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Inspect" name="Inspect the shipment">
        <bpmn:extensionElements>
          <zenbpm:taskDefinition type="inspect" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ToInspect</bpmn:incoming>
        <bpmn:outgoing>Flow_ToInspectApproved</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="InspectApproved" name="Approved?" default="Flow_ToInspectHeld">
        <bpmn:incoming>Flow_ToInspectApproved</bpmn:incoming>
        <bpmn:outgoing>Flow_ToInspectShipped</bpmn:outgoing>
        <bpmn:outgoing>Flow_ToInspectHeld</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="InspectedForShipping">
        <bpmn:incoming>Flow_ToInspectShipped</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="InspectedAndHeld">
        <bpmn:incoming>Flow_ToInspectHeld</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ToInspect" sourceRef="InspectionStarted" targetRef="Inspect" />
      <bpmn:sequenceFlow id="Flow_ToInspectApproved" sourceRef="Inspect" targetRef="InspectApproved" />
      <bpmn:sequenceFlow id="Flow_ToInspectShipped" sourceRef="InspectApproved" targetRef="InspectedForShipping">
        <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_ToInspectHeld" sourceRef="InspectApproved" targetRef="InspectedAndHeld" />
    </bpmn:subProcess>
    <bpmn:endEvent id="Inspected">
      <bpmn:incoming>Flow_ToInspected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToScenario" sourceRef="Ordered" targetRef="Scenario" />
    <bpmn:sequenceFlow id="Flow_ToWaitToShip" sourceRef="Scenario" targetRef="WaitToShip">
      <bpmn:conditionExpression>=scenario = "gateway"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToPacking" sourceRef="Scenario" targetRef="Packing">
      <bpmn:conditionExpression>=scenario = "subprocess"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToBoxing" sourceRef="Scenario" targetRef="Boxing">
      <bpmn:conditionExpression>=scenario = "iterations"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToInspection" sourceRef="Scenario" targetRef="Inspection">
      <bpmn:conditionExpression>=scenario = "task"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToShipApproved" sourceRef="WaitToShip" targetRef="ShipApproved" />
    <bpmn:sequenceFlow id="Flow_ToShipped" sourceRef="ShipApproved" targetRef="Shipped">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToHeld" sourceRef="ShipApproved" targetRef="Held" />
    <bpmn:sequenceFlow id="Flow_ToPacked" sourceRef="Packing" targetRef="Packed" />
    <bpmn:sequenceFlow id="Flow_ToBoxed" sourceRef="Boxing" targetRef="Boxed" />
    <bpmn:sequenceFlow id="Flow_ToInspected" sourceRef="Inspection" targetRef="Inspected" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Shipments">
      <bpmndi:BPMNShape id="Ordered_di" bpmnElement="Ordered">
