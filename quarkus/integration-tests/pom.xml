<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.pbinitiative.zenbpm</groupId>
    <artifactId>zenbpm-vanillabp-adapter-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>zenbpm-vanillabp-adapter-quarkus-integration-tests</artifactId>
  <name>VanillaBP adapter for ZenBPM - Quarkus extension - Integration tests</name>
  <description>End-to-end tests running the adapter's documented features on a booted Quarkus application against a real ZenBPM engine.</description>

  <properties>
    <!-- nothing to publish - this module only tests -->
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- the Netty a Quarkus application runs, see netty.version.quarkus in the root POM -->
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>${netty.version.quarkus}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-quarkus-integration</artifactId>
    </dependency>
    <dependency>
      <groupId>org.pbinitiative.zenbpm</groupId>
      <artifactId>zenbpm-vanillabp-adapter-quarkus</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- the introspection endpoints the test reaches the application in its own JVM through -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-config-yaml</artifactId>
    </dependency>
    <!-- the application uses the Micrometer extension, so the adapter publishes its meters -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-micrometer</artifactId>
    </dependency>
    <!-- the workflow aggregate is a JPA entity on an in-memory database, so the platform serves
         it with its JDBC phase-two outbox, as it serves an application in production -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-orm</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-agroal</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-h2</artifactId>
    </dependency>

    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit-internal</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>test-utils</artifactId>
      <scope>test</scope>
      <exclusions>
        <!-- the test logs through JBoss LogManager, as the application does, and a second SLF4J
             provider would make SLF4J report the ambiguity on every run -->
        <exclusion>
          <groupId>ch.qos.logback</groupId>
          <artifactId>logback-classic</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.pbinitiative.zenbpm</groupId>
      <artifactId>zenbpm-vanillabp-adapter-engine-test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- skips the test where no Docker environment is there, as every other engine test is -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            <maven.home>${maven.home}</maven.home>
            <maven.repo>${settings.localRepository}</maven.repo>
            <!--suppress UnresolvedMavenProperty - filled by goal jacoco-maven-plugin:prepare-agent in the root POM -->
            <!-- handed to the prod-mode test, which passes it on to the JVM of the application it
                 starts: without it that JVM writes no coverage, and the Quarkus report would not
                 see what the application ran -->
            <jacoco.agent>${jacoco.agent}</jacoco.agent>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- the platform reads the parameter names of a task handler -->
          <parameters>true</parameters>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
