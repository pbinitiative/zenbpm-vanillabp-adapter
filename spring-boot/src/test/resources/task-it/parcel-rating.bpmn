<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="task-it-parcel-rating"
    xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" targetNamespace="http://bpmn.io/schema/bpmn"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="ParcelRating" isExecutable="true">
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_ToRate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Rate" name="Rate the parcel">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="rate" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRated</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Rated">
      <bpmn:incoming>Flow_ToRated</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToRate" sourceRef="Start" targetRef="Rate" />
    <bpmn:sequenceFlow id="Flow_ToRated" sourceRef="Rate" targetRef="Rated" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ParcelRating">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="160" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Rate_di" bpmnElement="Rate">
        <dc:Bounds x="256" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Rated_di" bpmnElement="Rated">
        <dc:Bounds x="416" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToRate_di" bpmnElement="Flow_ToRate">
        <di:waypoint x="196" y="98" />
        <di:waypoint x="226" y="98" />
        <di:waypoint x="226" y="120" />
        <di:waypoint x="256" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToRated_di" bpmnElement="Flow_ToRated">
        <di:waypoint x="356" y="120" />
        <di:waypoint x="386" y="120" />
        <di:waypoint x="386" y="98" />
        <di:waypoint x="416" y="98" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
