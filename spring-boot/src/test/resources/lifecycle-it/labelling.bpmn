<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" id="labelling" targetNamespace="http://bpmn.io/schema/bpmn"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="Labelling" isExecutable="true">
    <bpmn:startEvent id="LabelAsked" name="Label asked for">
      <bpmn:outgoing>Flow_ToPrintLabel</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="PrintLabel" name="Print the label">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="printLabel" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPrintLabel</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLabelled</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Labelled" name="Labelled">
      <bpmn:incoming>Flow_ToLabelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToPrintLabel" sourceRef="LabelAsked" targetRef="PrintLabel" />
    <bpmn:sequenceFlow id="Flow_ToLabelled" sourceRef="PrintLabel" targetRef="Labelled" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Labelling">
      <bpmndi:BPMNShape id="LabelAsked_di" bpmnElement="LabelAsked">
        <dc:Bounds x="160" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PrintLabel_di" bpmnElement="PrintLabel">
        <dc:Bounds x="256" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Labelled_di" bpmnElement="Labelled">
        <dc:Bounds x="416" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToPrintLabel_di" bpmnElement="Flow_ToPrintLabel">
        <di:waypoint x="196" y="98" />
        <di:waypoint x="226" y="98" />
        <di:waypoint x="226" y="120" />
        <di:waypoint x="256" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToLabelled_di" bpmnElement="Flow_ToLabelled">
        <di:waypoint x="356" y="120" />
        <di:waypoint x="386" y="120" />
        <di:waypoint x="386" y="98" />
        <di:waypoint x="416" y="98" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
