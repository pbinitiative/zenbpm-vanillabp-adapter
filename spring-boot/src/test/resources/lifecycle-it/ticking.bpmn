<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" id="ticking" targetNamespace="http://bpmn.io/schema/bpmn"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:message id="Message_Proceed" name="proceed" />
  <bpmn:process id="Ticking" isExecutable="true">
    <bpmn:startEvent id="TwoSecondsAfterDeploying" name="Two seconds after deploying">
      <bpmn:outgoing>Flow_ToTick</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TwoSecondsAfterDeploying_Definition">
        <bpmn:timeCycle>R1/PT2S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Tick" name="Tick">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="tick" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToTick</bpmn:incoming>
      <bpmn:outgoing>Flow_ToProceed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="AwaitProceed" name="Await the go-ahead">
      <bpmn:incoming>Flow_ToProceed</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
      <bpmn:messageEventDefinition id="AwaitProceed_Definition" messageRef="Message_Proceed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Ticked" name="Ticked">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToTick" sourceRef="TwoSecondsAfterDeploying" targetRef="Tick" />
    <bpmn:sequenceFlow id="Flow_ToProceed" sourceRef="Tick" targetRef="AwaitProceed" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="AwaitProceed" targetRef="Ticked" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Ticking">
      <bpmndi:BPMNShape id="TwoSecondsAfterDeploying_di" bpmnElement="TwoSecondsAfterDeploying">
        <dc:Bounds x="160" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Tick_di" bpmnElement="Tick">
        <dc:Bounds x="256" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AwaitProceed_di" bpmnElement="AwaitProceed">
        <dc:Bounds x="416" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ticked_di" bpmnElement="Ticked">
        <dc:Bounds x="512" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToTick_di" bpmnElement="Flow_ToTick">
        <di:waypoint x="196" y="98" />
        <di:waypoint x="226" y="98" />
        <di:waypoint x="226" y="120" />
        <di:waypoint x="256" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToProceed_di" bpmnElement="Flow_ToProceed">
        <di:waypoint x="356" y="120" />
        <di:waypoint x="386" y="120" />
        <di:waypoint x="386" y="98" />
        <di:waypoint x="416" y="98" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEnd_di" bpmnElement="Flow_ToEnd">
        <di:waypoint x="452" y="98" />
        <di:waypoint x="512" y="98" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
