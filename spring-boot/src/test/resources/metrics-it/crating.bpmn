<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="metrics-it-crating"
    xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" targetNamespace="http://bpmn.io/schema/bpmn"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="Crating" isExecutable="true">
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_ToFork</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Fork">
      <bpmn:incoming>Flow_ToFork</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWeigh</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToSeal</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Weigh" name="Weigh the crate">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="weigh" retries="2" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToWeigh</bpmn:incoming>
      <bpmn:outgoing>Flow_WeighToJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Seal" name="Seal the crate">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="seal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSeal</bpmn:incoming>
      <bpmn:outgoing>Flow_SealToJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Join">
      <bpmn:incoming>Flow_WeighToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_SealToJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCrated</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="Crated">
      <bpmn:incoming>Flow_ToCrated</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToFork" sourceRef="Start" targetRef="Fork" />
    <bpmn:sequenceFlow id="Flow_ToWeigh" sourceRef="Fork" targetRef="Weigh" />
    <bpmn:sequenceFlow id="Flow_ToSeal" sourceRef="Fork" targetRef="Seal" />
    <bpmn:sequenceFlow id="Flow_WeighToJoin" sourceRef="Weigh" targetRef="Join" />
    <bpmn:sequenceFlow id="Flow_SealToJoin" sourceRef="Seal" targetRef="Join" />
    <bpmn:sequenceFlow id="Flow_ToCrated" sourceRef="Join" targetRef="Crated" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Crating">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="160" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fork_di" bpmnElement="Fork">
        <dc:Bounds x="256" y="80" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Weigh_di" bpmnElement="Weigh">
        <dc:Bounds x="366" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Seal_di" bpmnElement="Seal">
        <dc:Bounds x="366" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Join_di" bpmnElement="Join">
        <dc:Bounds x="526" y="80" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Crated_di" bpmnElement="Crated">
        <dc:Bounds x="636" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToFork_di" bpmnElement="Flow_ToFork">
        <di:waypoint x="196" y="98" />
        <di:waypoint x="226" y="98" />
        <di:waypoint x="226" y="105" />
        <di:waypoint x="256" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToWeigh_di" bpmnElement="Flow_ToWeigh">
        <di:waypoint x="306" y="105" />
        <di:waypoint x="336" y="105" />
        <di:waypoint x="336" y="120" />
        <di:waypoint x="366" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToSeal_di" bpmnElement="Flow_ToSeal">
        <di:waypoint x="306" y="105" />
        <di:waypoint x="336" y="105" />
        <di:waypoint x="336" y="250" />
        <di:waypoint x="366" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_WeighToJoin_di" bpmnElement="Flow_WeighToJoin">
        <di:waypoint x="466" y="120" />
        <di:waypoint x="496" y="120" />
        <di:waypoint x="496" y="105" />
        <di:waypoint x="526" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SealToJoin_di" bpmnElement="Flow_SealToJoin">
        <di:waypoint x="466" y="250" />
        <di:waypoint x="496" y="250" />
        <di:waypoint x="496" y="105" />
        <di:waypoint x="526" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToCrated_di" bpmnElement="Flow_ToCrated">
        <di:waypoint x="576" y="105" />
        <di:waypoint x="606" y="105" />
        <di:waypoint x="606" y="98" />
        <di:waypoint x="636" y="98" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
