<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="usertask-it-signatures"
    xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" targetNamespace="http://bpmn.io/schema/bpmn"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="Signing" isExecutable="true">
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_ToSign</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Sign" name="Sign the contract">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="sign" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSign</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSigned</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Signed">
      <bpmn:incoming>Flow_ToSigned</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToSign" sourceRef="Start" targetRef="Sign" />
    <bpmn:sequenceFlow id="Flow_ToSigned" sourceRef="Sign" targetRef="Signed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Signing">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="160" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sign_di" bpmnElement="Sign">
        <dc:Bounds x="256" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Signed_di" bpmnElement="Signed">
        <dc:Bounds x="416" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToSign_di" bpmnElement="Flow_ToSign">
        <di:waypoint x="196" y="98" />
        <di:waypoint x="226" y="98" />
        <di:waypoint x="226" y="120" />
        <di:waypoint x="256" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToSigned_di" bpmnElement="Flow_ToSigned">
        <di:waypoint x="356" y="120" />
        <di:waypoint x="386" y="120" />
        <di:waypoint x="386" y="98" />
        <di:waypoint x="416" y="98" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
