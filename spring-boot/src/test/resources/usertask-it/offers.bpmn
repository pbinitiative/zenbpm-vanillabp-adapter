<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="usertask-it-offers"
    xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" targetNamespace="http://bpmn.io/schema/bpmn"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="Offering" isExecutable="true">
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_ToSplit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Split">
      <bpmn:incoming>Flow_ToSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAccept</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToLater</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Accept" name="Accept the offer">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="accept" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAccept</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAccepted</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="OfferExpired" name="Offer expired" attachedToRef="Accept" cancelActivity="true">
      <bpmn:outgoing>Flow_ToExpired</bpmn:outgoing>
      <bpmn:timerEventDefinition id="OfferExpired_Definition">
        <bpmn:timeDuration>PT2S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Accepted">
      <bpmn:incoming>Flow_ToAccepted</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Expired">
      <bpmn:incoming>Flow_ToExpired</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Later" name="Later">
      <bpmn:incoming>Flow_ToLater</bpmn:incoming>
      <bpmn:outgoing>Flow_ToArchive</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Later_Definition">
        <bpmn:timeDuration>PT5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Archive" name="Archive the offer">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="archive" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToArchive</bpmn:incoming>
      <bpmn:outgoing>Flow_ToArchived</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Archived">
      <bpmn:incoming>Flow_ToArchived</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToSplit" sourceRef="Start" targetRef="Split" />
    <bpmn:sequenceFlow id="Flow_ToAccept" sourceRef="Split" targetRef="Accept" />
    <bpmn:sequenceFlow id="Flow_ToLater" sourceRef="Split" targetRef="Later" />
    <bpmn:sequenceFlow id="Flow_ToAccepted" sourceRef="Accept" targetRef="Accepted" />
    <bpmn:sequenceFlow id="Flow_ToExpired" sourceRef="OfferExpired" targetRef="Expired" />
    <bpmn:sequenceFlow id="Flow_ToArchive" sourceRef="Later" targetRef="Archive" />
    <bpmn:sequenceFlow id="Flow_ToArchived" sourceRef="Archive" targetRef="Archived" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Offering">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="160" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Split_di" bpmnElement="Split">
        <dc:Bounds x="256" y="80" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Accept_di" bpmnElement="Accept">
        <dc:Bounds x="366" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Later_di" bpmnElement="Later">
        <dc:Bounds x="398" y="210" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Accepted_di" bpmnElement="Accepted">
        <dc:Bounds x="558" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Archive_di" bpmnElement="Archive">
        <dc:Bounds x="526" y="166" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Archived_di" bpmnElement="Archived">
        <dc:Bounds x="686" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Expired_di" bpmnElement="Expired">
        <dc:Bounds x="160" y="296" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OfferExpired_di" bpmnElement="OfferExpired">
        <dc:Bounds x="440" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToSplit_di" bpmnElement="Flow_ToSplit">
        <di:waypoint x="196" y="98" />
        <di:waypoint x="226" y="98" />
        <di:waypoint x="226" y="105" />
        <di:waypoint x="256" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToAccept_di" bpmnElement="Flow_ToAccept">
        <di:waypoint x="306" y="105" />
        <di:waypoint x="336" y="105" />
        <di:waypoint x="336" y="120" />
        <di:waypoint x="366" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToLater_di" bpmnElement="Flow_ToLater">
        <di:waypoint x="306" y="105" />
        <di:waypoint x="352" y="105" />
        <di:waypoint x="352" y="228" />
        <di:waypoint x="398" y="228" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToAccepted_di" bpmnElement="Flow_ToAccepted">
        <di:waypoint x="466" y="120" />
        <di:waypoint x="512" y="120" />
        <di:waypoint x="512" y="98" />
        <di:waypoint x="558" y="98" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToExpired_di" bpmnElement="Flow_ToExpired">
        <di:waypoint x="458" y="178" />
        <di:waypoint x="458" y="352" />
        <di:waypoint x="178" y="352" />
        <di:waypoint x="178" y="332" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToArchive_di" bpmnElement="Flow_ToArchive">
        <di:waypoint x="434" y="228" />
        <di:waypoint x="480" y="228" />
        <di:waypoint x="480" y="206" />
        <di:waypoint x="526" y="206" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToArchived_di" bpmnElement="Flow_ToArchived">
        <di:waypoint x="626" y="206" />
        <di:waypoint x="656" y="206" />
        <di:waypoint x="656" y="98" />
        <di:waypoint x="686" y="98" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
