<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="usertask-it-endorsements"
    xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" targetNamespace="http://bpmn.io/schema/bpmn"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="Endorsing" isExecutable="true">
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_ToSplit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Split">
      <bpmn:incoming>Flow_ToSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndorse</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToWithdraw</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Endorse" name="Endorse the request">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="endorse" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToEndorse</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndorsed</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Endorsed">
      <bpmn:incoming>Flow_ToEndorsed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Withdraw" name="Withdraw the request">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="withdraw" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToWithdraw</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWithdrawn</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Withdrawn">
      <bpmn:incoming>Flow_ToWithdrawn</bpmn:incoming>
      <bpmn:terminateEventDefinition id="Withdrawn_Definition" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToSplit" sourceRef="Start" targetRef="Split" />
    <bpmn:sequenceFlow id="Flow_ToEndorse" sourceRef="Split" targetRef="Endorse" />
    <bpmn:sequenceFlow id="Flow_ToEndorsed" sourceRef="Endorse" targetRef="Endorsed" />
    <bpmn:sequenceFlow id="Flow_ToWithdraw" sourceRef="Split" targetRef="Withdraw" />
    <bpmn:sequenceFlow id="Flow_ToWithdrawn" sourceRef="Withdraw" targetRef="Withdrawn" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Endorsing">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="160" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Split_di" bpmnElement="Split">
        <dc:Bounds x="256" y="80" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Endorse_di" bpmnElement="Endorse">
        <dc:Bounds x="366" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Withdraw_di" bpmnElement="Withdraw">
        <dc:Bounds x="366" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Endorsed_di" bpmnElement="Endorsed">
        <dc:Bounds x="526" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Withdrawn_di" bpmnElement="Withdrawn">
        <dc:Bounds x="526" y="166" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToSplit_di" bpmnElement="Flow_ToSplit">
        <di:waypoint x="196" y="98" />
        <di:waypoint x="226" y="98" />
        <di:waypoint x="226" y="105" />
        <di:waypoint x="256" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEndorse_di" bpmnElement="Flow_ToEndorse">
        <di:waypoint x="306" y="105" />
        <di:waypoint x="336" y="105" />
        <di:waypoint x="336" y="120" />
        <di:waypoint x="366" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEndorsed_di" bpmnElement="Flow_ToEndorsed">
        <di:waypoint x="466" y="120" />
        <di:waypoint x="496" y="120" />
        <di:waypoint x="496" y="98" />
        <di:waypoint x="526" y="98" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToWithdraw_di" bpmnElement="Flow_ToWithdraw">
        <di:waypoint x="306" y="105" />
        <di:waypoint x="336" y="105" />
        <di:waypoint x="336" y="250" />
        <di:waypoint x="366" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToWithdrawn_di" bpmnElement="Flow_ToWithdrawn">
        <di:waypoint x="466" y="250" />
        <di:waypoint x="496" y="250" />
        <di:waypoint x="496" y="184" />
        <di:waypoint x="526" y="184" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
