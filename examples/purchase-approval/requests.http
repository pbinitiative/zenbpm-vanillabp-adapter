# Purchase approval, step by step, for the HTTP client of IntelliJ IDEA.
#
# Start the engine on port 8080 and zenbpm-ui as examples/README.md says, then either twin of this
# example (README "Run it"); both answer on port 8101. Run the requests of a scenario one after the
# other. A user task reaches the application within a second, so wait a moment before a step which
# expects one. A step which reads the request checks where it stands: a red check means "not yet",
# run it again. zenbpm-ui shows each request as an instance of purchase-approval__purchase_approval
# whose business key is the request's id.

@app = http://localhost:8101

### PurchaseApprovalIT#aPurchaseAboveTheLimitIsOrderedOnlyOnceTheManagerApprovesIt: 1. a request above the limit
POST {{app}}/purchase-requests
Content-Type: application/json

{"requester": "Jane Doe", "item": "CNC milling machine", "amount": 75000}

> {%
    client.global.set("largePurchase", response.body.id);
%}

### 2. the clerk's check is open (zenbpm-ui: the token waits at "Check the request")
GET {{app}}/purchase-requests/{{largePurchase}}

> {%
    client.test("the clerk's check is open", function () {
        client.assert(response.body.status === "IN_CHECK", "status is " + response.body.status);
    });
%}

### 3. the clerk finds it in order
POST {{app}}/purchase-requests/{{largePurchase}}/check
Content-Type: application/json

{"approved": true, "comment": "budget confirmed"}

### 4. above 50 000 the manager has to approve as well
GET {{app}}/purchase-requests/{{largePurchase}}

> {%
    client.test("the manager's approval is open", function () {
        client.assert(response.body.status === "IN_HIGH_VALUE_APPROVAL", "status is " + response.body.status);
    });
%}

### 5. the manager approves
POST {{app}}/purchase-requests/{{largePurchase}}/high-value-approval
Content-Type: application/json

{"approved": true, "comment": "fits the investment plan"}

### 6. ordered (zenbpm-ui: the instance is completed)
GET {{app}}/purchase-requests/{{largePurchase}}

> {%
    client.test("the purchase is ordered", function () {
        client.assert(response.body.status === "ORDERED", "status is " + response.body.status);
        client.assert(response.body.purchaseOrderNumber.startsWith("PO-"), "no purchase order");
    });
%}

### PurchaseApprovalIT#aSmallPurchaseTheClerkFindsInOrderIsOrdered: 1. a request up to the limit
POST {{app}}/purchase-requests
Content-Type: application/json

{"requester": "John Roe", "item": "office chair", "amount": 1200}

> {%
    client.global.set("smallPurchase", response.body.id);
%}

### 2. the clerk's check is open
GET {{app}}/purchase-requests/{{smallPurchase}}

> {%
    client.test("the clerk's check is open", function () {
        client.assert(response.body.status === "IN_CHECK", "status is " + response.body.status);
    });
%}

### 3. the clerk finds it in order
POST {{app}}/purchase-requests/{{smallPurchase}}/check
Content-Type: application/json

{"approved": true, "comment": "standard equipment"}

### 4. ordered after the clerk's check alone: the manager never saw it
GET {{app}}/purchase-requests/{{smallPurchase}}

> {%
    client.test("the purchase is ordered", function () {
        client.assert(response.body.status === "ORDERED", "status is " + response.body.status);
    });
%}

### PurchaseApprovalIT#aPurchaseTheManagerRejectsIsReportedToTheRequester: 1. a request above the limit
POST {{app}}/purchase-requests
Content-Type: application/json

{"requester": "Jane Doe", "item": "company car", "amount": 62000}

> {%
    client.global.set("rejectedByTheManager", response.body.id);
%}

### 2. the clerk's check is open
GET {{app}}/purchase-requests/{{rejectedByTheManager}}

> {%
    client.test("the clerk's check is open", function () {
        client.assert(response.body.status === "IN_CHECK", "status is " + response.body.status);
    });
%}

### 3. the clerk finds it in order
POST {{app}}/purchase-requests/{{rejectedByTheManager}}/check
Content-Type: application/json

{"approved": true, "comment": "budget confirmed"}

### 4. the manager's approval is open
GET {{app}}/purchase-requests/{{rejectedByTheManager}}

> {%
    client.test("the manager's approval is open", function () {
        client.assert(response.body.status === "IN_HIGH_VALUE_APPROVAL", "status is " + response.body.status);
    });
%}

### 5. the manager rejects
POST {{app}}/purchase-requests/{{rejectedByTheManager}}/high-value-approval
Content-Type: application/json

{"approved": false, "comment": "a leased car is cheaper"}

### 6. rejected, and the requester is told (the application logs the mail)
GET {{app}}/purchase-requests/{{rejectedByTheManager}}

> {%
    client.test("the requester is told", function () {
        client.assert(response.body.status === "REJECTED", "status is " + response.body.status);
        client.assert(response.body.requesterNotified === true, "the requester is not told yet");
    });
%}

### PurchaseApprovalIT#aRequestTheClerkRejectsNeverReachesTheManager: 1. a request above the limit
POST {{app}}/purchase-requests
Content-Type: application/json

{"requester": "John Roe", "item": "espresso machine", "amount": 55000}

> {%
    client.global.set("rejectedByTheClerk", response.body.id);
%}

### 2. the clerk's check is open
GET {{app}}/purchase-requests/{{rejectedByTheClerk}}

> {%
    client.test("the clerk's check is open", function () {
        client.assert(response.body.status === "IN_CHECK", "status is " + response.body.status);
    });
%}

### 3. the clerk rejects it
POST {{app}}/purchase-requests/{{rejectedByTheClerk}}/check
Content-Type: application/json

{"approved": false, "comment": "not a business expense"}

### 4. rejected without the manager (zenbpm-ui: the path ends after the check)
GET {{app}}/purchase-requests/{{rejectedByTheClerk}}

> {%
    client.test("rejected by the clerk", function () {
        client.assert(response.body.status === "REJECTED", "status is " + response.body.status);
        client.assert(response.body.requesterNotified === true, "the requester is not told yet");
    });
%}

### PurchaseApprovalIT#anAnswerForATaskWhichIsNotOpenIsRefused: the manager's approval of the small purchase above, which never needed one
POST {{app}}/purchase-requests/{{smallPurchase}}/high-value-approval
Content-Type: application/json

{"approved": true}

> {%
    client.test("409 Conflict", function () {
        client.assert(response.status === 409, "answered " + response.status);
    });
%}

### PurchaseApprovalIT#anUnknownRequestIsNotFound: an id nobody submitted
GET {{app}}/purchase-requests/no-such-request

> {%
    client.test("404 Not Found", function () {
        client.assert(response.status === 404, "answered " + response.status);
    });
%}

### PurchaseApprovalIT#anInvalidRequestIsRefused: an amount which is not positive
POST {{app}}/purchase-requests
Content-Type: application/json

{"requester": "Jane Doe", "item": "laptop", "amount": -100}

> {%
    client.test("400 Bad Request", function () {
        client.assert(response.status === 400, "answered " + response.status);
    });
%}

### PurchaseApprovalIT#anInvalidRequestIsRefused: a request without a requester
POST {{app}}/purchase-requests
Content-Type: application/json

{"item": "laptop", "amount": 1200}

> {%
    client.test("400 Bad Request", function () {
        client.assert(response.status === 400, "answered " + response.status);
    });
%}

# Not here: PurchaseApprovalIT#answersGivenAtTheSameTimeDecideOnce sends eight answers at the same
# moment, which an HTTP client that sends one request after the other cannot do.
