<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.pbinitiative.zenbpm</groupId>
    <artifactId>zenbpm-vanillabp-adapter-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>zenbpm-vanillabp-adapter-smoke-test</artifactId>
  <name>VanillaBP adapter for ZenBPM - Smoke test</name>
  <description>Discovery, health and startup validation of the adapter on Spring Boot without an engine, in a Maven module of its own so its workflow module is one of its own.</description>

  <properties>
    <!-- nothing to publish - this module only tests -->
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.pbinitiative.zenbpm</groupId>
      <artifactId>zenbpm-vanillabp-adapter-spring-boot</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- the persistence of the platform's JDBC outbox and delivery log -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>test-utils</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- the health support the platform's health indicator needs, which is optional there -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-health</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- a second adapter type, so an application can boot without any ZenBPM adapter id -->
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>bpms-double-spring-boot</artifactId>
      <version>${adapter-platform.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
