<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.pbinitiative.zenbpm</groupId>
    <artifactId>zenbpm-vanillabp-adapter-test-coverage-report</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>zenbpm-vanillabp-adapter-coverage-gate</artifactId>
  <name>VanillaBP adapter for ZenBPM - Test coverage gate</name>
  <description>Breaks the build when a platform's aggregated coverage drops below the threshold, or when a module produces coverage data no aggregated report reads. Declared as the LAST module of the reactor, because it judges what the other modules produced.</description>

  <properties>
    <!-- nothing to publish - this module only judges the reports -->
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <!-- the gate contributes no coverage itself, so it needs no entry in any report;
         the empty agent keeps Surefire's inherited '@{jacoco.agent}' resolvable -->
    <jacoco.skip>true</jacoco.skip>
    <jacoco.agent/>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>test-utils</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <!-- the module has no main sources -->
          <skipIfEmpty>true</skipIfEmpty>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <coverage.repository.root>${project.basedir}/../..</coverage.repository.root>
            <!-- the gate runs in 'test', the reports it reads are written in 'verify' of
                 the modules before it, so it has to know whether this run gets that far.
                 Maven's own goals arrive empty as a system property; the command line its
                 launcher exports carries the same answer as text -->
            <coverage.maven.command>${env.MAVEN_CMD_LINE_ARGS}</coverage.maven.command>
            <coverage.threshold.spring-boot>${coverage.threshold.spring-boot}</coverage.threshold.spring-boot>
            <coverage.threshold.quarkus>${coverage.threshold.quarkus}</coverage.threshold.quarkus>
            <coverage.rule>${coverage.rule}</coverage.rule>
            <!-- what EnginePinTest holds the copies of the pin to -->
            <zenbpm.commit>${zenbpm.commit}</zenbpm.commit>
            <zenbpm.image>${zenbpm.image}</zenbpm.image>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
