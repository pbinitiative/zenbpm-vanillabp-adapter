<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="jobTasks" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="Message_Shipped" name="shipped" />
  <bpmn:process id="Orders" name="Orders" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:properties />
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start" />
    <bpmn:serviceTask id="Charge" name="Charge the card">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="charge" />
        <zeebe:ioMapping>
          <zeebe:input source="=order.total" target="amount" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Unwired" name="Nobody serves me" />
    <bpmn:sendTask id="Notify">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify" />
      </bpmn:extensionElements>
    </bpmn:sendTask>
    <bpmn:businessRuleTask id="Rate" name="Rate the customer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="rate" />
      </bpmn:extensionElements>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="Decide" name="The engine decides">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="discount" resultVariable="discount" />
      </bpmn:extensionElements>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="RateWithoutDecision" name="No decision named">
      <bpmn:extensionElements>
        <zeebe:calledDecision />
        <zeebe:taskDefinition type="rate-again" />
      </bpmn:extensionElements>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="DecideBlank" name="A blank decision id is a decision">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId=" " />
        <zeebe:taskDefinition type="never-a-job" />
      </bpmn:extensionElements>
    </bpmn:businessRuleTask>
    <bpmn:callActivity id="Invoice">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Invoicing" />
        <zeebe:in businessKey="=orderId" />
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:subProcess id="EveryParcel">
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=parcels" inputElement="parcel" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="EveryParcel_Start" />
    </bpmn:subProcess>
    <bpmn:intermediateThrowEvent id="Announce" name="Announce">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="announce" />
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="Announce_Definition" messageRef="Message_Shipped" />
    </bpmn:intermediateThrowEvent>
    <bpmn:receiveTask id="AwaitShipping" name="Await shipping" messageRef="Message_Shipped" />
    <bpmn:userTask id="Approve" name="Approve the order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="approve" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Review" />
    <bpmn:subProcess id="Packing">
      <bpmn:startEvent id="Packing_Start" />
      <bpmn:serviceTask id="Pack" name="Pack">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="pack" />
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Packing_End" />
    </bpmn:subProcess>
    <bpmn:endEvent id="Shipped" name="Report the shipping">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="report-shipping" />
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="Shipped_Definition" messageRef="Message_Shipped" />
    </bpmn:endEvent>
    <bpmn:endEvent id="Done" />
  </bpmn:process>
</bpmn:definitions>
