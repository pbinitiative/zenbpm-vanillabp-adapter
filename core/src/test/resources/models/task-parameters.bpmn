<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" id="taskParameters" targetNamespace="http://bpmn.io/schema/bpmn"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="Orders" isExecutable="true">
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Charge">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="charge" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sendTask id="NotifyEveryCustomer">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="notify" />
      </bpmn:extensionElements>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zenbpm:loopCharacteristics inputCollection="=customers" inputElement="customer" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:sendTask>
    <bpmn:subProcess id="EveryParcel">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:extensionElements>
        <zenbpm:ioMapping>
          <zenbpm:input source="=parcelWeight" target="weight" />
        </zenbpm:ioMapping>
      </bpmn:extensionElements>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zenbpm:loopCharacteristics inputCollection="=parcels" inputElement="parcel" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="EveryParcel_Start">
        <bpmn:outgoing>Flow_P1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Ship">
        <bpmn:incoming>Flow_P1</bpmn:incoming>
        <bpmn:outgoing>Flow_P2</bpmn:outgoing>
        <bpmn:extensionElements>
          <zenbpm:taskDefinition type="ship" />
          <zenbpm:ioMapping>
            <zenbpm:input source="=parcel.address" target="address" />
          </zenbpm:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:userTask id="Sign">
        <bpmn:incoming>Flow_P2</bpmn:incoming>
        <bpmn:outgoing>Flow_P3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:subProcess id="EveryItem">
        <bpmn:incoming>Flow_P3</bpmn:incoming>
        <bpmn:outgoing>Flow_P4</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true">
          <bpmn:extensionElements>
            <zenbpm:loopCharacteristics inputCollection="=parcel.items" inputElement="item" />
          </bpmn:extensionElements>
        </bpmn:multiInstanceLoopCharacteristics>
        <bpmn:startEvent id="EveryItem_Start">
          <bpmn:outgoing>Flow_I1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:serviceTask id="Label">
          <bpmn:incoming>Flow_I1</bpmn:incoming>
          <bpmn:outgoing>Flow_I2</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="EveryItem_End">
          <bpmn:incoming>Flow_I2</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_I1" sourceRef="EveryItem_Start" targetRef="Label" />
        <bpmn:sequenceFlow id="Flow_I2" sourceRef="Label" targetRef="EveryItem_End" />
      </bpmn:subProcess>
      <bpmn:endEvent id="EveryParcel_End">
        <bpmn:incoming>Flow_P4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_P1" sourceRef="EveryParcel_Start" targetRef="Ship" />
      <bpmn:sequenceFlow id="Flow_P2" sourceRef="Ship" targetRef="Sign" />
      <bpmn:sequenceFlow id="Flow_P3" sourceRef="Sign" targetRef="EveryItem" />
      <bpmn:sequenceFlow id="Flow_P4" sourceRef="EveryItem" targetRef="EveryParcel_End" />
    </bpmn:subProcess>
    <bpmn:endEvent id="Done">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Charge" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Charge" targetRef="NotifyEveryCustomer" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="NotifyEveryCustomer" targetRef="EveryParcel" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="EveryParcel" targetRef="Done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Orders">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="160" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Charge_di" bpmnElement="Charge">
        <dc:Bounds x="256" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotifyEveryCustomer_di" bpmnElement="NotifyEveryCustomer">
        <dc:Bounds x="416" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EveryParcel_di" bpmnElement="EveryParcel" isExpanded="true">
        <dc:Bounds x="576" y="80" width="924" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EveryParcel_Start_di" bpmnElement="EveryParcel_Start">
        <dc:Bounds x="606" y="110" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ship_di" bpmnElement="Ship">
        <dc:Bounds x="702" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sign_di" bpmnElement="Sign">
        <dc:Bounds x="862" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EveryItem_di" bpmnElement="EveryItem" isExpanded="true">
        <dc:Bounds x="1022" y="110" width="352" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EveryItem_Start_di" bpmnElement="EveryItem_Start">
        <dc:Bounds x="1052" y="140" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Label_di" bpmnElement="Label">
        <dc:Bounds x="1148" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EveryItem_End_di" bpmnElement="EveryItem_End">
        <dc:Bounds x="1308" y="140" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EveryParcel_End_di" bpmnElement="EveryParcel_End">
        <dc:Bounds x="1434" y="110" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Done_di" bpmnElement="Done">
        <dc:Bounds x="1560" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_I1_di" bpmnElement="Flow_I1">
        <di:waypoint x="1088" y="158" />
        <di:waypoint x="1118" y="158" />
        <di:waypoint x="1118" y="180" />
        <di:waypoint x="1148" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_I2_di" bpmnElement="Flow_I2">
        <di:waypoint x="1248" y="180" />
        <di:waypoint x="1278" y="180" />
        <di:waypoint x="1278" y="158" />
        <di:waypoint x="1308" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P1_di" bpmnElement="Flow_P1">
        <di:waypoint x="642" y="128" />
        <di:waypoint x="672" y="128" />
        <di:waypoint x="672" y="150" />
        <di:waypoint x="702" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P2_di" bpmnElement="Flow_P2">
        <di:waypoint x="802" y="150" />
        <di:waypoint x="862" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P3_di" bpmnElement="Flow_P3">
        <di:waypoint x="962" y="150" />
        <di:waypoint x="992" y="150" />
        <di:waypoint x="992" y="180" />
        <di:waypoint x="1022" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_P4_di" bpmnElement="Flow_P4">
        <di:waypoint x="1374" y="180" />
        <di:waypoint x="1404" y="180" />
        <di:waypoint x="1404" y="128" />
        <di:waypoint x="1434" y="128" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="196" y="98" />
        <di:waypoint x="226" y="98" />
        <di:waypoint x="226" y="120" />
        <di:waypoint x="256" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="356" y="120" />
        <di:waypoint x="416" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="516" y="120" />
        <di:waypoint x="546" y="120" />
        <di:waypoint x="546" y="180" />
        <di:waypoint x="576" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="1500" y="180" />
        <di:waypoint x="1530" y="180" />
        <di:waypoint x="1530" y="98" />
        <di:waypoint x="1560" y="98" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
