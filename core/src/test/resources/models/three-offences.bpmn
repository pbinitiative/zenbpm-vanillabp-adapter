<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="threeOffences" targetNamespace="http://bpmn.io/schema/bpmn"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:message id="Message_Order" name="order" />
  <bpmn:signal id="Signal_Recall" name="recall" />
  <bpmn:process id="Orders" isExecutable="true">
    <bpmn:receiveTask id="OrderReceived" instantiate="true" messageRef="Message_Order">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:scriptTask id="Calculate" scriptFormat="feel">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:script>=amount * 2</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Retry">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="retry" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics />
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Recalled" attachedToRef="Retry">
      <bpmn:signalEventDefinition id="Recalled_Definition" signalRef="Signal_Recall" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Done">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="OrderReceived" targetRef="Calculate" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Calculate" targetRef="Retry" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Retry" targetRef="Done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Orders">
      <bpmndi:BPMNShape id="OrderReceived_di" bpmnElement="OrderReceived">
        <dc:Bounds x="160" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Calculate_di" bpmnElement="Calculate">
        <dc:Bounds x="320" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Retry_di" bpmnElement="Retry">
        <dc:Bounds x="480" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Done_di" bpmnElement="Done">
        <dc:Bounds x="640" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Recalled_di" bpmnElement="Recalled">
        <dc:Bounds x="554" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="260" y="120" />
        <di:waypoint x="320" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="420" y="120" />
        <di:waypoint x="480" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="580" y="120" />
        <di:waypoint x="610" y="120" />
        <di:waypoint x="610" y="98" />
        <di:waypoint x="640" y="98" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
