<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" id="expressions" targetNamespace="http://bpmn.io/schema/bpmn"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:message id="Message_Paid" name="paid">
    <bpmn:extensionElements>
      <zenbpm:subscription correlationKey="=orderId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_Ordered" name="=ordered">
    <bpmn:extensionElements>
      <zenbpm:subscription correlationKey="=customerId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="Orders" isExecutable="true">
    <bpmn:startEvent id="Ordered">
      <bpmn:messageEventDefinition id="Ordered_Definition" messageRef="Message_Ordered" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="HowBig" />
    <bpmn:sequenceFlow id="Flow_Big" sourceRef="HowBig" targetRef="Paid">
      <bpmn:conditionExpression>= amount &gt; 100</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Literal" sourceRef="HowBig" targetRef="Paid">
      <bpmn:conditionExpression>true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:intermediateCatchEvent id="Paid">
      <bpmn:messageEventDefinition id="Paid_Definition" messageRef="Message_Paid" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Wait">
      <bpmn:timerEventDefinition id="Wait_Definition">
        <bpmn:timeDuration>=delay</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="EveryParcel">
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zenbpm:loopCharacteristics inputCollection="=parcels" inputElement="parcel"
              outputCollection="weights" outputElement="=parcel.weight" />
        </bpmn:extensionElements>
        <bpmn:completionCondition>=done</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="EveryParcel_Start" />
      <bpmn:endEvent id="EveryParcel_End" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="Charge" name="=label">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="=dynamicType" retries="=maxAttempts" retryBackoff="=backoff" />
        <zenbpm:ioMapping>
          <zenbpm:input source="=customer.name" target="name" />
          <zenbpm:input source="fixed" target="kind" />
          <zenbpm:output source="=receipt" target="receipt" />
        </zenbpm:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="Review">
      <bpmn:extensionElements>
        <zenbpm:assignmentDefinition assignee="=reviewer" candidateGroups="=groups" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:callActivity id="Invoice">
      <bpmn:extensionElements>
        <zenbpm:calledElement processId="=target" />
        <zenbpm:in businessKey="=orderId" />
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:endEvent id="Done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Orders">
      <bpmndi:BPMNShape id="HowBig_di" bpmnElement="HowBig">
        <dc:Bounds x="160" y="80" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Paid_di" bpmnElement="Paid">
        <dc:Bounds x="270" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ordered_di" bpmnElement="Ordered">
        <dc:Bounds x="160" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Wait_di" bpmnElement="Wait">
        <dc:Bounds x="256" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EveryParcel_di" bpmnElement="EveryParcel" isExpanded="true">
        <dc:Bounds x="352" y="180" width="200" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EveryParcel_Start_di" bpmnElement="EveryParcel_Start">
        <dc:Bounds x="382" y="210" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EveryParcel_End_di" bpmnElement="EveryParcel_End">
        <dc:Bounds x="478" y="210" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Charge_di" bpmnElement="Charge">
        <dc:Bounds x="612" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Review_di" bpmnElement="Review">
        <dc:Bounds x="772" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Invoice_di" bpmnElement="Invoice">
        <dc:Bounds x="932" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Done_di" bpmnElement="Done">
        <dc:Bounds x="1092" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Big_di" bpmnElement="Flow_Big">
        <di:waypoint x="210" y="105" />
        <di:waypoint x="240" y="105" />
        <di:waypoint x="240" y="98" />
        <di:waypoint x="270" y="98" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Literal_di" bpmnElement="Flow_Literal">
        <di:waypoint x="210" y="105" />
        <di:waypoint x="240" y="105" />
        <di:waypoint x="240" y="98" />
        <di:waypoint x="270" y="98" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
