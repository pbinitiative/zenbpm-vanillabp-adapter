<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="twoProcesses"
    targetNamespace="http://bpmn.io/schema/bpmn"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Shop" processRef="Orders" />
    <bpmn:participant id="Warehouse" processRef="Warehouse_Documentation" />
  </bpmn:collaboration>
  <bpmn:process id="Orders" isExecutable="true">
    <bpmn:startEvent id="Start" />
    <bpmn:endEvent id="Done" />
  </bpmn:process>
  <bpmn:process id="Warehouse_Documentation" isExecutable="false">
    <bpmn:startEvent id="Warehouse_Start" />
    <bpmn:endEvent id="Warehouse_Done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="Shop_di" bpmnElement="Shop" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="600" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Warehouse_di" bpmnElement="Warehouse" isHorizontal="true">
        <dc:Bounds x="160" y="230" width="600" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="220" y="110" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Done_di" bpmnElement="Done">
        <dc:Bounds x="316" y="110" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Warehouse_Start_di" bpmnElement="Warehouse_Start">
        <dc:Bounds x="220" y="260" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Warehouse_Done_di" bpmnElement="Warehouse_Done">
        <dc:Bounds x="316" y="260" width="36" height="36" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
