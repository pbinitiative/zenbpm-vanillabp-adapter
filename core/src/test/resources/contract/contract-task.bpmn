<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" id="Definitions_ContractTask" targetNamespace="http://bpmn.io/schema/bpmn"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="contract-task" isExecutable="true">
    <bpmn:startEvent id="StartEvent">
      <bpmn:outgoing>Flow_ToWork</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToWork" sourceRef="StartEvent" targetRef="Task_Work" />
    <bpmn:serviceTask id="Task_Work" name="Work">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="contract-work" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToWork</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPaid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToPaid" sourceRef="Task_Work" targetRef="Catch_Paid" />
    <bpmn:intermediateCatchEvent id="Catch_Paid" name="Paid">
      <bpmn:incoming>Flow_ToPaid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Definition_Paid" messageRef="Message_Paid" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Catch_Paid" targetRef="EndEvent" />
    <bpmn:endEvent id="EndEvent">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:message id="Message_Paid" name="contract-paid">
    <bpmn:extensionElements>
      <zenbpm:subscription correlationKey="=orderId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="contract-task">
      <bpmndi:BPMNShape id="StartEvent_di" bpmnElement="StartEvent">
        <dc:Bounds x="160" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Work_di" bpmnElement="Task_Work">
        <dc:Bounds x="256" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Catch_Paid_di" bpmnElement="Catch_Paid">
        <dc:Bounds x="416" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_di" bpmnElement="EndEvent">
        <dc:Bounds x="512" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToWork_di" bpmnElement="Flow_ToWork">
        <di:waypoint x="196" y="98" />
        <di:waypoint x="226" y="98" />
        <di:waypoint x="226" y="120" />
        <di:waypoint x="256" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToPaid_di" bpmnElement="Flow_ToPaid">
        <di:waypoint x="356" y="120" />
        <di:waypoint x="386" y="120" />
        <di:waypoint x="386" y="98" />
        <di:waypoint x="416" y="98" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEnd_di" bpmnElement="Flow_ToEnd">
        <di:waypoint x="452" y="98" />
        <di:waypoint x="512" y="98" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
