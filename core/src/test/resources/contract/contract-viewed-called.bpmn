<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" id="Definitions_ContractViewedCalled" targetNamespace="http://bpmn.io/schema/bpmn"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="contract-viewed-called" isExecutable="true">
    <bpmn:startEvent id="CalledStart">
      <bpmn:outgoing>Flow_ToCalledWork</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="CalledWork">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="contract-viewed-called" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCalledWork</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCalledEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CalledEnd">
      <bpmn:incoming>Flow_ToCalledEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToCalledWork" sourceRef="CalledStart" targetRef="CalledWork" />
    <bpmn:sequenceFlow id="Flow_ToCalledEnd" sourceRef="CalledWork" targetRef="CalledEnd" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="contract-viewed-called">
      <bpmndi:BPMNShape id="CalledStart_di" bpmnElement="CalledStart">
        <dc:Bounds x="160" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CalledWork_di" bpmnElement="CalledWork">
        <dc:Bounds x="256" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CalledEnd_di" bpmnElement="CalledEnd">
        <dc:Bounds x="416" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToCalledWork_di" bpmnElement="Flow_ToCalledWork">
        <di:waypoint x="196" y="98" />
        <di:waypoint x="226" y="98" />
        <di:waypoint x="226" y="120" />
        <di:waypoint x="256" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToCalledEnd_di" bpmnElement="Flow_ToCalledEnd">
        <di:waypoint x="356" y="120" />
        <di:waypoint x="386" y="120" />
        <di:waypoint x="386" y="98" />
        <di:waypoint x="416" y="98" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
