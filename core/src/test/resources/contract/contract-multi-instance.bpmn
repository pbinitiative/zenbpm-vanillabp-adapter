<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="contract-multi-instance-definitions"
    xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" targetNamespace="http://bpmn.io/schema/bpmn"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <bpmn:process id="contract-multi-instance" isExecutable="true">
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_ToEach</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Each">
      <bpmn:incoming>Flow_ToEach</bpmn:incoming>
      <bpmn:outgoing>Flow_ToOneByOne</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zenbpm:loopCharacteristics inputCollection="=items" inputElement="item" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="Each_Start">
        <bpmn:outgoing>Flow_ToEachTask</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="EachTask">
        <bpmn:extensionElements>
          <zenbpm:taskDefinition type="contract-each" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ToEachTask</bpmn:incoming>
        <bpmn:outgoing>Flow_ToEachEnd</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Each_End">
        <bpmn:incoming>Flow_ToEachEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ToEachTask" sourceRef="Each_Start" targetRef="EachTask" />
      <bpmn:sequenceFlow id="Flow_ToEachEnd" sourceRef="EachTask" targetRef="Each_End" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="OneByOne">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="contract-one-by-one" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToOneByOne</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:extensionElements>
          <zenbpm:loopCharacteristics inputCollection="=items" inputElement="item" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToEach" sourceRef="Start" targetRef="Each" />
    <bpmn:sequenceFlow id="Flow_ToOneByOne" sourceRef="Each" targetRef="OneByOne" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="OneByOne" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="contract-multi-instance">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="160" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Each_di" bpmnElement="Each" isExpanded="true">
        <dc:Bounds x="256" y="80" width="352" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Each_Start_di" bpmnElement="Each_Start">
        <dc:Bounds x="286" y="110" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EachTask_di" bpmnElement="EachTask">
        <dc:Bounds x="382" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Each_End_di" bpmnElement="Each_End">
        <dc:Bounds x="542" y="110" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OneByOne_di" bpmnElement="OneByOne">
        <dc:Bounds x="668" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="828" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToEachTask_di" bpmnElement="Flow_ToEachTask">
        <di:waypoint x="322" y="128" />
        <di:waypoint x="352" y="128" />
        <di:waypoint x="352" y="150" />
        <di:waypoint x="382" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEachEnd_di" bpmnElement="Flow_ToEachEnd">
        <di:waypoint x="482" y="150" />
        <di:waypoint x="512" y="150" />
        <di:waypoint x="512" y="128" />
        <di:waypoint x="542" y="128" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEach_di" bpmnElement="Flow_ToEach">
        <di:waypoint x="196" y="98" />
        <di:waypoint x="226" y="98" />
        <di:waypoint x="226" y="150" />
        <di:waypoint x="256" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToOneByOne_di" bpmnElement="Flow_ToOneByOne">
        <di:waypoint x="608" y="150" />
        <di:waypoint x="638" y="150" />
        <di:waypoint x="638" y="120" />
        <di:waypoint x="668" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEnd_di" bpmnElement="Flow_ToEnd">
        <di:waypoint x="768" y="120" />
        <di:waypoint x="798" y="120" />
        <di:waypoint x="798" y="98" />
        <di:waypoint x="828" y="98" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
