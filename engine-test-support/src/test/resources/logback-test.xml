<configuration>
    <!-- The template for every module with integration tests: copy it into the module's
         src/test/resources unchanged.

         The root level does the quieting. Logback defaults to DEBUG, and docker-java then
         debug-logs every request to the Docker daemon. org.testcontainers, tc and
         com.github.dockerjava stay at INFO and are not raised to WARN. Logback discards a
         record below its logger's level before any appender sees it, so
         SuppressOutputExtension could not replay it for a FAILING class either. And that
         replay should say which image was started, and when.
         In a green build, INFO still shows a handful of lines. Testcontainers writes them
         while it looks for Docker, in the ExecutionCondition of
         '@Testcontainers(disabledWithoutDocker = true)'. That runs before any extension
         callback, so no extension can hold these lines back. The VanillaBP repositories
         settled on the same root level for the same reason. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- what the engine container printed, see EngineLog -->
    <logger name="zenbpm-engine" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
