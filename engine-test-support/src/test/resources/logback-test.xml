<configuration>
    <!-- The template for every module with integration tests: copy it into the module's
         src/test/resources unchanged.

         The root level does the quieting. Logback defaults to DEBUG, and docker-java then
         debug-logs every request to the Docker daemon. org.testcontainers, tc and
         com.github.dockerjava stay at INFO and are not raised to WARN. A record which its
         level drops reaches no appender, so SuppressOutputExtension could not replay it for a
         FAILING class either. And that replay should say which image was started, and when.
         What INFO costs in a green build is the handful of lines written before the first
         extension callback (Docker detection runs in the ExecutionCondition of
         '@Testcontainers(disabledWithoutDocker = true)'), which no extension reaches. The
         VanillaBP repositories settled on the same root level for the same reason. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- what the engine container printed, see EngineLog -->
    <logger name="zenbpm-engine" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
